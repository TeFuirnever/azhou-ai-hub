      "setup_runs": 1,
      "prelude": [],
      "event": {
        "command": "setup",
        "argv": [
          "--scope",
          "project"
        ]
      },
      "expect_contains": [],
      "expect_absent": [],
      "expect_settings": {
        "session_start_owned": 1,
        "prompt_owned": 1,
        "timeout": 5,
        "matcher": "startup|resume|clear|compact"
      },
      "expect_exit_nonzero": false
