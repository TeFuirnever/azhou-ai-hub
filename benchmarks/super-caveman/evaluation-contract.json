  "promotion_review": {
    "baseline": "the pinned original Caveman core plus its six companion skill entrypoints, without Super Caveman or i-have-adhd response rules",
    "candidate": "the frozen Super Caveman runtime used by the passing behavior result",
    "same_cases_required": true,
    "independent_paired_judges": 3,
    "presentation_orders": [
      "candidate-baseline",
      "baseline-candidate",
      "candidate-baseline"
    ],
    "candidate_majority_required": 2,
    "high_risk_regressions_allowed": 0,
    "judge_records": "Git-external; aggregate identities, orders, votes, digests, and limitations belong in the passing result",
    "exact_diff_human_approval": {
      "required": true,
      "schema": "super-caveman-exact-diff-approval.v2",
      "review_scope": "all staged task paths except the aggregate result and aggregate approval record",
      "digest_algorithm": "sha256 over sorted canonical path/blob tuples after excluding the aggregate result and aggregate approval record; each tuple binds the relative path, base blob object ID or deletion marker, and target blob object ID or deletion marker with NUL delimiters; path_set_sha256 separately binds the sorted NUL-delimited path set; raw Git metadata makes the digest independent of display diff configuration, attributes, custom diff drivers, text conversion, and rename detection; the benchmark recomputes the staged index tuple set before commit and the equivalent base_commit..approval-anchor tuple set on committed replay; the v2 aggregate receipt retains the same sorted reviewed_blobs tuple list so public squash replay can validate approved target blobs when the base commit is no longer ancestral",
      "record_storage": "Git aggregate receipt; raw approval Git-external",
      "raw_record_schema": "super-caveman-exact-diff-human-record.v1",
      "raw_record_environment": "SUPER_CAVEMAN_APPROVAL_RECORD",
      "review_record_environment": "SUPER_CAVEMAN_REVIEW_RECORD",
      "raw_record_validation": "required for every promotion ingest and replay; SUPER_CAVEMAN_APPROVAL_RECORD and SUPER_CAVEMAN_REVIEW_RECORD must both name absolute Git-external regular files; verify the approval record's actual SHA-256, schema, decision, approver, timestamp, base commit, path-set digest, and tuple digest; verify the reviewer record's actual SHA-256, schema, identity, candidate raw-output SHA-256, and case-set SHA-256 against the aggregate result",
      "approved_replay_validation": "every promotion replay revalidates both Git-external raw records before deterministic verification; current staged or committed exact-diff validation remains required for promotion; staged replay also requires the aggregate result and aggregate approval record to have byte-identical index and working-tree copies; committed replay anchors to a base-descendant and HEAD-ancestor commit whose canonical tuple set matches reviewed_blobs, permits later unrelated commits, and rejects later commits or working-tree changes that touch any approved subject path; public squash replay may use reviewed_blobs only when exact history is unavailable, and each approved target blob must match HEAD with no working-tree change on an approved path",
      "required_approved_fields": [
        "status",
        "approver",
        "approved_at",
        "base_commit",
        "path_set_sha256",
        "staged_patch_sha256",
        "record_path",
        "record_sha256"
      ]
    },
