{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [{"$ref":"#/$defs/detector"},{"$ref":"#/$defs/decision"}],
  "$defs": {
    "hex":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "non_negative_integer":{"type":"integer","minimum":0},
    "pair_integer":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"integer"}},
    "text_evidence":{"type":"object","additionalProperties":false,"required":["overlap_x","overlap_y"],"properties":{"overlap_x":{"$ref":"#/$defs/non_negative_integer"},"overlap_y":{"$ref":"#/$defs/non_negative_integer"}}},
    "nesting_evidence":{"type":"object","additionalProperties":false,"required":["left","top","right","bottom","inside","outside"],"properties":{"left":{"$ref":"#/$defs/non_negative_integer"},"top":{"$ref":"#/$defs/non_negative_integer"},"right":{"$ref":"#/$defs/non_negative_integer"},"bottom":{"$ref":"#/$defs/non_negative_integer"},"inside":{"$ref":"#/$defs/non_negative_integer"},"outside":{"$ref":"#/$defs/non_negative_integer"}}},
    "straddle_evidence":{"type":"object","additionalProperties":false,"required":["inside","outside","dx_inside","dy_inside"],"properties":{"inside":{"$ref":"#/$defs/non_negative_integer"},"outside":{"$ref":"#/$defs/non_negative_integer"},"dx_inside":{"$ref":"#/$defs/pair_integer"},"dy_inside":{"$ref":"#/$defs/pair_integer"}}},
    "subject_ids":{"type":"array","minItems":2,"maxItems":2,"uniqueItems":true,"items":{"type":"string"}},
    "issue":{"oneOf":[
      {"type":"object","additionalProperties":false,"required":["code","subject_ids","severity","evidence","issue_key","identity_digest","evidence_digest"],"properties":{"code":{"const":"TEXT_TEXT"},"subject_ids":{"$ref":"#/$defs/subject_ids"},"severity":{"$ref":"#/$defs/non_negative_integer"},"evidence":{"$ref":"#/$defs/text_evidence"},"issue_key":{"type":"string"},"identity_digest":{"$ref":"#/$defs/hex"},"evidence_digest":{"$ref":"#/$defs/hex"}}},
      {"type":"object","additionalProperties":false,"required":["code","subject_ids","severity","evidence","issue_key","identity_digest","evidence_digest"],"properties":{"code":{"const":"NESTING"},"subject_ids":{"$ref":"#/$defs/subject_ids"},"severity":{"$ref":"#/$defs/non_negative_integer"},"evidence":{"$ref":"#/$defs/nesting_evidence"},"issue_key":{"type":"string"},"identity_digest":{"$ref":"#/$defs/hex"},"evidence_digest":{"$ref":"#/$defs/hex"}}},
      {"type":"object","additionalProperties":false,"required":["code","subject_ids","severity","evidence","issue_key","identity_digest","evidence_digest"],"properties":{"code":{"const":"STRADDLE"},"subject_ids":{"$ref":"#/$defs/subject_ids"},"severity":{"$ref":"#/$defs/non_negative_integer"},"evidence":{"$ref":"#/$defs/straddle_evidence"},"issue_key":{"type":"string"},"identity_digest":{"$ref":"#/$defs/hex"},"evidence_digest":{"$ref":"#/$defs/hex"}}}
    ]},
    "detector":{"type":"object","additionalProperties":false,"required":["record_type","schema_version","state","scene_digest","issues"],"properties":{"record_type":{"const":"detector"},"schema_version":{"const":"excalidraw.overlap-audit.v1"},"state":{"enum":["clean","issues","error"]},"scene_digest":{"$ref":"#/$defs/hex"},"issues":{"type":"array","items":{"$ref":"#/$defs/issue"}}}},
    "decision":{"type":"object","additionalProperties":false,"required":["record_type","schema_version","round","attempt","edit_applied","scene_digest","detector_digest","previous_detector_digest","previous_decision_digest","decision","repair_allowed","progress_relation"],"properties":{"record_type":{"const":"decision"},"schema_version":{"const":"excalidraw.overlap-audit.v1"},"round":{"type":"integer","minimum":1,"maximum":4},"attempt":{"type":"integer","minimum":0,"maximum":3},"edit_applied":{"type":"boolean"},"scene_digest":{"$ref":"#/$defs/hex"},"detector_digest":{"$ref":"#/$defs/hex"},"previous_detector_digest":{"anyOf":[{"$ref":"#/$defs/hex"},{"type":"null"}]},"previous_decision_digest":{"anyOf":[{"$ref":"#/$defs/hex"},{"type":"null"}]},"decision":{"enum":["error","clean","continue","stalled","exhausted"]},"repair_allowed":{"type":"boolean"},"progress_relation":{"enum":["not_compared","improved","regressed","unchanged","incomparable"]}}}
  }
}
