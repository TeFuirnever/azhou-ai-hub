{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azhou.ai/schemas/repo-pedant/inventory.v2.json",
  "title": "Repo-pedant knowledge inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "projects", "files", "history_sources", "checks", "holds", "notes"],
  "properties": {
    "schema_version": {"const": "repo-pedant.inventory.v2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["root", "root_entries", "runnable_stage", "relationship", "memory_inventory"],
        "properties": {
          "root": {"type": "string", "minLength": 1},
          "root_entries": {"type": "array", "items": {"type": "string"}},
          "runnable_stage": {"type": ["boolean", "null"]},
          "relationship": {"const": "affected"},
          "memory_inventory": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "paths", "evidence"],
            "properties": {
              "status": {"enum": ["unresolved", "bound", "none_discovered", "hold"]},
              "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "evidence": {"type": "string"}
            }
          }
        }
      }
    },
    "files": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "history_sources": {"type": "array", "minItems": 1},
    "checks": {"type": "object"},
    "holds": {"type": "array"},
    "notes": {"type": "array"}
  }
}
