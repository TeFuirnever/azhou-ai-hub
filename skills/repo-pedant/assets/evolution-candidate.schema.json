{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azhou.ai/schemas/repo-pedant/evolution-candidate.v1.json",
  "title": "Repo-pedant isolated evolution candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "created_at", "status", "scope", "mechanism", "change_summary", "regression_id", "signal_ids", "independent_sessions", "projects", "severe_trigger", "parse_errors", "origin", "live_skill_modified"],
  "properties": {
    "schema_version": {"const": "repo-pedant.evolution-candidate.v1"},
    "candidate_id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"const": "proposed"},
    "scope": {"enum": ["project", "global"]},
    "mechanism": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "change_summary": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\r\\n]+$"},
    "regression_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "signal_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "independent_sessions": {"type": "integer", "minimum": 1},
    "projects": {"type": "integer", "minimum": 1},
    "severe_trigger": {"type": "boolean"},
    "parse_errors": {"type": "integer", "minimum": 0},
    "origin": {"enum": ["curated", "learned", "imported", "unknown"]},
    "live_skill_modified": {"const": false},
    "archived_signal_count": {"type": "integer", "minimum": 1},
    "evidence_archive": {"type": "string", "minLength": 1}
  }
}
