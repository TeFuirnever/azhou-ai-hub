{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azhou.ai/schemas/repo-pedant-history-v1.json",
  "title": "Repo Pedant privacy-preserving history report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "skill_names",
    "privacy",
    "runtime_coverage",
    "runs_found",
    "outcome_counts",
    "runs"
  ],
  "properties": {
    "schema_version": {"const": "repo-pedant.history.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "skill_names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text_included",
        "excerpts_redacted_and_truncated",
        "identifiers_hashed",
        "transcripts_treated_as_untrusted"
      ],
      "properties": {
        "raw_text_included": {"type": "boolean"},
        "excerpts_redacted_and_truncated": {"type": "boolean"},
        "identifiers_hashed": {"const": true},
        "transcripts_treated_as_untrusted": {"const": true}
      },
      "allOf": [
        {
          "if": {"properties": {"raw_text_included": {"const": true}}},
          "then": {"properties": {"excerpts_redacted_and_truncated": {"const": true}}}
        }
      ]
    },
    "runtime_coverage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "codex": {"$ref": "#/$defs/coverage"},
        "claude": {"$ref": "#/$defs/coverage"},
        "zcode": {"$ref": "#/$defs/coverage"}
      }
    },
    "runs_found": {"type": "integer", "minimum": 0},
    "outcome_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aborted": {"type": "integer", "minimum": 0},
        "user_corrected": {"type": "integer", "minimum": 0},
        "tool_failure_signal": {"type": "integer", "minimum": 0},
        "receipt_emitted": {"type": "integer", "minimum": 0},
        "insufficient_evidence": {"type": "integer", "minimum": 0}
      }
    },
    "runs": {
      "type": "array",
      "items": {"$ref": "#/$defs/run"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files_scanned", "parse_errors", "runs_found", "limit_per_runtime"],
      "properties": {
        "files_scanned": {"type": "integer", "minimum": 0},
        "parse_errors": {"type": "integer", "minimum": 0},
        "runs_found": {"type": "integer", "minimum": 0},
        "limit_per_runtime": {"type": "integer", "minimum": 1}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "runtime",
        "origin",
        "session_digest",
        "source_digest",
        "session_started_at",
        "request_digest",
        "invocation_kind",
        "assistant_messages",
        "tool_calls_heuristic",
        "mutation_calls_heuristic",
        "destructive_calls_heuristic",
        "failed_tool_outputs_heuristic",
        "user_corrections_heuristic",
        "aborted",
        "receipt_present",
        "outcome_signal"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/digest"},
        "runtime": {"enum": ["codex", "claude", "zcode"]},
        "origin": {"type": ["string", "null"]},
        "session_digest": {"$ref": "#/$defs/digest"},
        "source_digest": {"$ref": "#/$defs/digest"},
        "session_started_at": {"type": ["string", "null"], "format": "date-time"},
        "request_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "invocation_kind": {"enum": ["explicit_user", "skill_tool", "skill_file_read", "receipt_inferred"]},
        "assistant_messages": {"type": "integer", "minimum": 0},
        "tool_calls_heuristic": {"type": "integer", "minimum": 0},
        "mutation_calls_heuristic": {"type": "integer", "minimum": 0},
        "destructive_calls_heuristic": {"type": "integer", "minimum": 0},
        "failed_tool_outputs_heuristic": {"type": "integer", "minimum": 0},
        "user_corrections_heuristic": {"type": "integer", "minimum": 0},
        "aborted": {"type": "boolean"},
        "receipt_present": {"type": "boolean"},
        "outcome_signal": {"enum": ["aborted", "user_corrected", "tool_failure_signal", "receipt_emitted", "insufficient_evidence"]},
        "request_excerpt": {"type": "string"},
        "correction_excerpts": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
