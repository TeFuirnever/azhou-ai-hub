<!doctype html>
<html lang="{{ "zh-CN" if lang == "zh" else lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% if sourceLibrary.preview %}<meta name="robots" content="noindex, nofollow">{% endif %}
  <title>{{ title | escape }}{% if title != "Azhou AI Hub" %} · Azhou AI Hub{% endif %}</title>
  {%- if description %}
  <meta name="description" content="{{ description }}">
  {%- endif %}
  {%- set ogImage = site.siteUrl ~ "/assets/azhou-workspace.png" %}
  <link rel="canonical" href="{{ site.siteUrl }}{{ page.url }}">
  {%- if route %}
  <link rel="alternate" hreflang="en" href="{{ site.siteUrl }}{{ alternatePaths.en or site.routes.en[route] }}">
  <link rel="alternate" hreflang="zh-CN" href="{{ site.siteUrl }}{{ alternatePaths.zh or site.routes.zh[route] }}">
  {%- endif %}
  <link rel="alternate" type="application/rss+xml" title="Azhou Source Library" href="{{ '/library/rss.xml' | url }}">
  {% if sourceFeed %}<link rel="alternate" type="application/rss+xml" title="{{ title | escape }} RSS" href="{{ sourceFeed | url }}">{% endif %}
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🦊</text></svg>">
  <meta name="theme-color" content="#f6f1e7" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#1a211d" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Azhou AI Hub">
  <meta property="og:title" content="{{ title | escape }}">
  {%- if description %}
  <meta property="og:description" content="{{ description }}">
  {%- endif %}
  <meta property="og:url" content="{{ site.siteUrl }}{{ page.url }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title | escape }}">
  {%- if description %}
  <meta name="twitter:description" content="{{ description }}">
  {%- endif %}
  <meta name="twitter:image" content="{{ ogImage }}">
  <script>
    window.addEventListener("pagereveal", ({ viewTransition }) => {
      if (!viewTransition) return;
      const motion = matchMedia("(prefers-reduced-motion: reduce)");
      const traversal = window.navigation?.activation?.navigationType === "traverse";
      if (motion.matches || traversal || location.hash || scrollY > 0) {
        viewTransition.skipTransition();
        return;
      }
      const listener = new AbortController();
      const stop = () => viewTransition.skipTransition();
      const options = { capture: true, passive: true, signal: listener.signal };
      for (const event of ["pointerdown", "keydown", "wheel", "touchmove", "scroll", "resize", "pagehide"]) {
        window.addEventListener(event, stop, options);
      }
      motion.addEventListener("change", stop, options);
      const cleanup = () => listener.abort();
      viewTransition.finished.then(cleanup, cleanup);
    });
  </script>
  <style>
    :root {
      color-scheme: light dark;
      --motion-feedback: 120ms;
      --motion-change: 160ms;
      --motion-expand: 240ms;
      --motion-ease: cubic-bezier(.23, 1, .32, 1);
      /* State and opacity lean forward; anything that travels a distance
         (a disclosure's box, an anchor glide) starts and settles gently. */
      --motion-move: cubic-bezier(.4, 0, .2, 1);
      --az-bg: #f6f1e7;
      --az-bg-2: #f0ecde;
      --az-bg-3: #e5e8d9;
      --az-card: #fffbf1;
      --az-border: #7c8970;
      --az-border-2: #c5c9b7;
      --az-text: #212d26;
      --az-text-2: #4d5a51;
      --az-accent: #31533f;
      --az-accent-hover: #294636;
      --az-accent-active: #223a2d;
      --az-accent-surface: #e2e9d9;
      --az-btn-text: #fffaf0;
      --az-code-bg: #ebe6d9;
      --az-code-text: #2e4236;
      --az-brand-text: #a04023;
      --az-band: var(--az-bg-2);
      --az-band-border: var(--az-border-2);
      --az-shadow-head: 0 6px 16px rgba(33, 45, 38, .09);
      --az-font: "Avenir Next", "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", system-ui, sans-serif;
      --az-display: "Iowan Old Style", "Songti SC", "Noto Serif CJK SC", "SimSun", Georgia, serif;
      --az-mono: "Roboto Mono", "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --az-bg: #1a211d;
        --az-bg-2: #1e2822;
        --az-bg-3: #304033;
        --az-card: #222c25;
        --az-border: #78917b;
        --az-border-2: #515e50;
        --az-text: #f0ebde;
        --az-text-2: #c1cbbd;
        --az-accent: #b4d1b3;
        --az-accent-hover: #c9e1c9;
        --az-accent-active: #9dbc9d;
        --az-accent-surface: rgba(143, 212, 171, .16);
        --az-btn-text: #192920;
        --az-code-bg: #25332a;
        --az-code-text: #e2ede0;
        --az-brand-text: #f3a181;
        --az-shadow-head: 0 6px 16px rgba(0, 0, 0, .42);
      }
    }
    * { box-sizing: border-box; }
    /* The fallback is the wide header's own height, so a deep link lands right
       before the observer has measured it. */
    html { scroll-padding-top: calc(var(--site-header-height, 4.6rem) + 25px); }
    body {
      margin: 0;
      background: var(--az-bg);
      color: var(--az-text);
      font: 400 16px/24px var(--az-font);
    }
    ::view-transition { pointer-events: none; }
    ::view-transition-group(*), ::view-transition-new(*) { animation: none; }
    ::view-transition-old(*) { display: none; }
    ::view-transition-group(hub-heading) { z-index: 1; }
    ::view-transition-group(hub-header) { z-index: 2; }
    @media (prefers-reduced-motion: no-preference) {
      @view-transition { navigation: auto; }
      :root { view-transition-name: none; }
      .site-head { view-transition-name: hub-header; }
      main h1 { view-transition-name: hub-heading; }
      @keyframes route-enter {
        from { opacity: .78; transform: translateY(3px); }
      }
      ::view-transition-new(hub-heading) {
        mix-blend-mode: normal;
        animation: route-enter var(--motion-change) var(--motion-ease) both;
      }
    }
    /* Resting underlines stay legible on every surface, then answer the pointer
       with the shared feedback curve. Writing the offset on :hover moved it. */
    a {
      color: var(--az-accent);
      text-decoration: underline;
      text-decoration-color: currentColor;
      text-decoration-color: color-mix(in srgb, currentColor 68%, transparent);
      text-underline-offset: .15em;
    }
    :where(a:active:not(.btn, .gcard, .capability-link, .channel-list a)) { color: var(--az-accent-active); }
    @media (hover: hover) and (pointer: fine) {
      a:hover, a:active { text-decoration-color: currentColor; }
    }
    :focus-visible { outline: 2px solid var(--az-accent); outline-offset: 2px; border-radius: 2px; }
    ::selection { background: var(--az-accent); color: var(--az-btn-text); }
    .skip-link {
      position: absolute; left: -9999px; top: 1rem; z-index: 100;
      background: var(--az-accent); color: var(--az-btn-text);
      padding: .5rem .9rem; border-radius: 4px;
      font: 500 14px/20px var(--az-font); text-decoration: none;
    }
    .skip-link:focus-visible { left: 1rem; }
    .brand-rule {
      height: 1px;
      background: var(--az-border-2);
    }
    .site-head {
      position: sticky; top: 0; z-index: 10;
      background: var(--az-bg);
      border-bottom: 1px solid var(--az-border-2);
      box-shadow: 0 6px 16px transparent;
    }
    /* The shadow fades in paint rather than through an opacity layer, whose
       teardown makes WebKit read its start value on the last frame. */
    @media (min-width: 680px) {
      .site-head[data-elevated] { box-shadow: var(--az-shadow-head); }
    }
    .site-head nav {
      display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: center;
      min-height: 64px; max-width: 1120px; margin: 0 auto; padding: 8px 24px;
    }
    body.doc .site-head nav { max-width: 1440px; }
    .brand { font: 500 16px/24px var(--az-font); color: var(--az-text); text-decoration: none; padding: 8px 8px; margin: -8px 0 -8px -8px; }
    .site-head nav a:not(.brand) {
      font: 500 14px/20px var(--az-font);
      color: var(--az-text-2); text-decoration: none;
      padding: 8px 10px; border-radius: 4px;
    }
    .site-head nav a[aria-current="page"] { background: var(--az-accent-surface); color: var(--az-accent); }
    .spacer { flex: 1; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
    .band { background: var(--az-band); border-bottom: 1px solid var(--az-band-border); }
    .band .wrap { padding-top: 60px; padding-bottom: 60px; }
    .band h1 {
      font: 500 44px/52px var(--az-font);
      letter-spacing: 0;
      margin: 0 0 16px;
      max-width: 24ch;
    }
    .lede { font: 400 20px/32px var(--az-font); color: var(--az-text-2); margin: 0 0 16px; max-width: 52ch; }
    /* ch-based caps measure Latin glyphs; on zh they orphan single CJK glyphs
       at the line end, so zh hero text wraps on the band width instead. */
    :lang(zh) .band h1, :lang(zh) .lede { max-width: none; }
    .cta { display: flex; flex-wrap: wrap; gap: 12px; margin: 0 0 32px; }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; min-block-size: 36px; padding: 0 24px;
      appearance: none; border-radius: 4px; border: 0; background: transparent; cursor: pointer;
      font: 500 14px/20px var(--az-font); text-decoration: none;
    }
    .btn-primary { background: var(--az-accent); color: var(--az-btn-text); }
    .btn-outline { border: 1px solid var(--az-border); color: var(--az-text); }
    .btn-outline:not(:disabled):active, .site-head nav a:active, summary:active, .channel-list a:active { background: var(--az-accent-surface); }
    .btn:disabled { color: var(--az-text-2); cursor: default; }
    .btn-outline:disabled { border-color: var(--az-border-2); }
    [hidden] { display: none !important; }
    .sec { padding: 60px 0; }
    .copy-actions {
      display: grid; grid-template-columns: max-content minmax(0, 1fr);
      align-items: center; justify-items: start; gap: .25rem .75rem;
    }
    .copy-status {
      display: flex; align-items: baseline; gap: .35em;
      min-block-size: 1.5rem; color: var(--az-text-2);
    }
    .copy-check { display: none; }
    .copy-status[data-state="success"] .copy-check { display: inline; }
    .copy-status[data-state="success"] { color: var(--az-accent); }
    @media (max-width: 599px) {
      .copy-actions { grid-template-columns: minmax(0, 1fr); }
      .copy-status { min-block-size: 3rem; }
    }
    details summary {
      cursor: pointer; width: fit-content; padding: .5rem .45rem; margin-inline: -.45rem;
      border-radius: 4px; color: var(--az-accent); list-style: none;
    }
    details summary::-webkit-details-marker { display: none; }
    details summary::before {
      content: ""; display: inline-block; inline-size: .42em; block-size: .42em;
      margin-inline: .15em .6em; vertical-align: .12em;
      border-inline-end: 2px solid; border-block-end: 2px solid;
      transform: rotate(-45deg);
    }
    details[open] > summary::before { transform: rotate(45deg); }
    /* The arrival mark breathes around its heading; the negative margins keep the text in place. */
    .hub-arrived { border-radius: 4px; }
    :is(h1, h2, h3, h4).hub-arrived { margin: -.25rem -.45rem; padding: .25rem .45rem; }
    #skill-filter { margin-top: 24px; }
    #skill-filter label { display: block; margin-block-end: .25rem; }
    .skill-search-controls { display: flex; align-items: center; gap: .5rem; }
    #skill-search {
      width: min(100%, 24rem); min-width: 0; min-height: 44px; padding: .5rem .75rem; border-radius: 4px;
      border: 1px solid var(--az-text-2); background: var(--az-bg); color: var(--az-text); font: inherit;
    }
    #skill-search::-webkit-search-cancel-button { appearance: none; }
    #clear-skill-search { flex: none; min-height: 44px; padding-inline: .75rem; }
    #skill-count { color: var(--az-text-2); margin: .5rem 0 0; font-variant-numeric: tabular-nums; }
    .skill-name { align-self: flex-start; margin-block-start: auto; overflow-wrap: anywhere; font-size: 12px; }
    .gcard:active { background: var(--az-accent-surface); }
    .sec h2 { font: 500 24px/32px var(--az-font); letter-spacing: 0; margin: 0 0 16px; }
    .sec > .wrap > p { margin: 0 0 16px; max-width: 72ch; }
    code {
      font-family: var(--az-mono); font-size: 100%;
      background: var(--az-code-bg); color: var(--az-code-text);
      padding: 1px 4px; border-radius: 3px;
    }
    pre {
      background: var(--az-code-bg); color: var(--az-code-text);
      font: 400 14px/24px var(--az-mono);
      padding: 16px 20px; border-radius: 4px;
      overflow-x: auto; margin: 16px 0 24px;
    }
    pre.wrap-text { white-space: pre-wrap; overflow-wrap: anywhere; }
    .cardgrid {
      list-style: none; padding: 0; margin: 16px 0 32px;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 16px;
    }
    .gcard {
      display: flex; flex-direction: column; gap: 6px; height: 100%;
      background: var(--az-card);
      border: 1px solid var(--az-border); border-radius: 8px;
      padding: 16px; text-decoration: none;
    }
    .gcard-t { font: 500 16px/1.3 var(--az-font); color: var(--az-accent); }
    .gcard-d { font: 400 13px/1.45 var(--az-font); color: var(--az-text-2); overflow-wrap: anywhere; }
    .btn-primary:active { background: var(--az-accent-active); }
    @media (prefers-reduced-motion: reduce) {
      .hub-arrived { background: var(--az-accent-surface); }
    }
    @media (prefers-reduced-motion: no-preference) {
      @keyframes state-arrive {
        from { opacity: .65; }
      }
      .btn { transition: color var(--motion-feedback) var(--motion-ease), border-color var(--motion-feedback) var(--motion-ease); }
      a { transition: text-decoration-color var(--motion-feedback) var(--motion-ease); }
      a:active { transition: none; }
      .site-head { transition: box-shadow var(--motion-feedback) var(--motion-ease); }
      summary::before { transition: transform var(--motion-change) var(--motion-move); }
      @supports selector(details::details-content) {
        details[open]::details-content { animation: state-arrive var(--motion-change) var(--motion-ease); }
      }
      /* Without the content pseudo-element the children fade in themselves. */
      @supports not selector(details::details-content) {
        details[open] > :not(summary) { animation: state-arrive var(--motion-change) var(--motion-ease); }
      }
      /* Where both the content pseudo-element and keyword interpolation exist,
         the disclosure opens and closes on its own box. Closing is the shorter
         change. flow-root keeps child margins inside the box so the last frame
         cannot jump; visibility is discrete so the content stays while it leaves. */
      @supports (interpolate-size: allow-keywords) and (transition-behavior: allow-discrete) and selector(details::details-content) {
        :root { interpolate-size: allow-keywords; }
        details[open] > summary::before { transition-duration: var(--motion-expand); }
        details::details-content {
          display: flow-root;
          content-visibility: visible;
          visibility: hidden;
          block-size: 0;
          /* The negative margins cancel the padding, so resting layout stays put
             while focus rings keep their room inside the clip. */
          padding: 6px 8px;
          margin: -6px -8px;
          overflow: clip;
          opacity: 0;
          transition:
            block-size var(--motion-change) var(--motion-move),
            visibility var(--motion-change),
            opacity var(--motion-change) var(--motion-ease);
          transition-behavior: allow-discrete;
        }
        details[open]::details-content {
          animation: none;
          visibility: visible;
          block-size: auto;
          opacity: 1;
          transition-duration: var(--motion-expand), var(--motion-expand), var(--motion-change);
        }
      }
    }
    @media (prefers-reduced-motion: reduce) {
      summary::before { transition: none; }
    }
    .gcard:focus-visible { border-color: var(--az-accent); }
    .doc-shell { max-width: 1440px; margin: 0 auto; padding: 32px 24px 72px; }
    .doc-card {
      background: var(--az-card);
      border-radius: 2px;
      padding: 40px;
      max-width: 1072px;
    }
    .doc-card h1 { font: 500 32px/40px var(--az-font); letter-spacing: 0; margin: 0 0 24px; }
    .doclist { list-style: none; padding: 0; margin: 16px 0 24px; }
    .doclist li { padding: 8px 0; border-bottom: 1px solid var(--az-border-2); }
    .site-foot { border-top: 0; }
    .site-foot .wrap { padding-top: 32px; padding-bottom: 48px; font: 400 13px/20px var(--az-font); color: var(--az-text-2); }
    body.doc .site-foot .wrap { max-width: 1440px; }
    .site-foot p { margin: 4px 0; max-width: 90ch; }
    .site-foot a { color: var(--az-accent); }
    @media (max-width: 679px) {
      html { scroll-padding-top: 16px; }
      .site-head { position: static; }
      .site-head nav { gap: 4px; }
      .brand { flex-basis: 100%; }
      .spacer { display: none; }
      .site-head nav a:not(.brand) { padding-inline: 7px; }
      .band .wrap { padding-top: 40px; padding-bottom: 40px; }
      .band h1 { font: 500 32px/40px var(--az-font); }
      .lede { font: 400 18px/28px var(--az-font); }
      .sec { padding: 40px 0; }
    }
    @media (max-width: 959px) {
      .doc-card { padding: 24px; }
    }
    @media (pointer: coarse) {
      .btn { min-block-size: 44px; }
      .site-head nav a:not(.brand) { min-block-size: 44px; display: flex; align-items: center; }
    }
    @media print {
      .site-head, .site-foot, .brand-rule { display: none; }
      body, body.doc { color: #000; background: #fff; }
      .doc-card { box-shadow: none; }
    }
  </style>
  <link rel="stylesheet" href="{{ '/assets/azhou-site.css' | url }}">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a class="skip-link" href="#main">{{ '跳到正文' if lang == 'zh' else 'Skip to content' }}</a>
  <div class="brand-rule" aria-hidden="true"></div>
  <header class="site-head">
    <nav aria-label="{{ '站内导航' if lang == 'zh' else 'Site' }}">
      <a class="brand" href="{{ site.routes[lang].home | url }}"><span class="brand-mark" aria-hidden="true">舟</span> {{ '阿舟 AI 能力站' if lang == 'zh' else 'Azhou AI Hub' }}</a>
      {%- for entry in ["skills", "library", "docs", "support"] %}
      <a href="{{ site.routes[lang][entry] | url }}"{% if route == entry %} aria-current="page"{% endif %}>{{ site.labels[lang][entry] }}</a>
      {%- endfor %}
      <span class="spacer"></span>
      <a href="{{ site.githubUrl }}">GitHub</a>
      {%- if route %}
      {%- set other = "en" if lang == "zh" else "zh" %}
      {%- set otherBcp47 = "en" if other == "en" else "zh-CN" %}
      <a id="switch-language" href="{{ (alternatePaths[other] or site.routes[other][route]) | url }}" lang="{{ otherBcp47 }}" hreflang="{{ otherBcp47 }}">{{ site.labels[lang].switchLang }}</a>
      {%- endif %}
    </nav>
  </header>
  <main id="main" tabindex="-1"{% if bodyClass == "doc" %} class="doc-shell"{% endif %}>
    {{ content | safe }}
  </main>
  <div class="brand-rule" aria-hidden="true"></div>
  <footer class="site-foot">
    <div class="wrap">
      {%- if lang == "zh" %}
      <p>阿舟自研代码使用 <a href="{{ site.blobBase }}/LICENSE">MIT</a>。阿舟素材使用 <a href="{{ site.blobBase }}/assets/azhou/NOTICE.md">CC BY-NC-ND 4.0</a>。名称、标识与角色见 <a href="{{ site.blobBase }}/TRADEMARKS.md">TRADEMARKS.md</a>。第三方组件保留自己的版权与许可证：<a href="{{ site.blobBase }}/THIRD_PARTY_NOTICES.md">THIRD_PARTY_NOTICES.md</a>。</p>
      {%- else %}
      <p>Azhou-maintained code: <a href="{{ site.blobBase }}/LICENSE">MIT</a>. Azhou artwork: <a href="{{ site.blobBase }}/assets/azhou/NOTICE.md">CC BY-NC-ND 4.0</a>. Name, logo and character: <a href="{{ site.blobBase }}/TRADEMARKS.md">TRADEMARKS.md</a>. Third-party components retain their own notices and licenses: <a href="{{ site.blobBase }}/THIRD_PARTY_NOTICES.md">THIRD_PARTY_NOTICES.md</a>.</p>
      {%- endif %}
      <p>Azhou artwork © 小亮 (阿舟 / Azhou), CC BY-NC-ND 4.0</p>
    </div>
  </footer>
  <script>
    {%- if route %}
    if ("ResizeObserver" in window) {
      let previousHeight;
      new ResizeObserver(([entry]) => {
        const height = entry.borderBoxSize?.[0]?.blockSize ?? entry.target.offsetHeight;
        if (height === previousHeight) return;
        previousHeight = height;
        document.documentElement.style.setProperty("--site-header-height", height + "px");
      }).observe(document.querySelector(".site-head"), { box: "border-box" });
    }
    const languageLink = document.getElementById("switch-language");
    function syncLanguageLink() {
      languageLink.hash = window.location.hash;
    }
    window.addEventListener("hashchange", syncLanguageLink);
    syncLanguageLink();
    {%- endif %}
    (() => {
      const motion = matchMedia("(prefers-reduced-motion: reduce)");
      const tokens = getComputedStyle(document.documentElement);
      const easing = tokens.getPropertyValue("--motion-ease").trim();
      const curve = /^cubic-bezier\(([^)]+)\)$/.exec(tokens.getPropertyValue("--motion-move").trim());
      // The glide reads the same curve as the stylesheet instead of keeping a second one.
      const bezier = curve && (([x1, y1, x2, y2]) => {
        const point = (a, b) => (t) => 3 * a * (1 - t) ** 2 * t + 3 * b * (1 - t) * t * t + t ** 3;
        const slope = (a, b) => (t) => 3 * (1 - t) ** 2 * a + 6 * (1 - t) * t * (b - a) + 3 * t * t * (1 - b);
        const x = point(x1, x2), y = point(y1, y2), dx = slope(x1, x2);
        return (progress) => {
          if (progress <= 0 || progress >= 1) return progress;
          let t = progress;
          for (let i = 0; i < 6; i += 1) {
            const steep = dx(t);
            if (Math.abs(steep) < 1e-6) break;
            t -= (x(t) - progress) / steep;
          }
          return y(t);
        };
      })(curve[1].split(",").map(Number));
      const duration = (token) => parseFloat(tokens.getPropertyValue(token));

      const head = document.querySelector(".site-head");
      const top = document.querySelector(".brand-rule");
      if ("IntersectionObserver" in window) {
        new IntersectionObserver(([entry]) => {
          head.toggleAttribute("data-elevated", !entry.isIntersecting);
        }).observe(top);
      }

      // Arrival answers "where did I land" once instead of leaving a frame on the target.
      // The next input dismisses it, which also covers a glide the user interrupts.
      let arrival = [];
      let marked = [];
      function dismissMark() {
        for (const animation of arrival) animation.cancel();
        arrival = [];
        for (const element of marked) element.classList.remove("hub-arrived");
        marked = [];
      }
      function landingBox(target) {
        return target.matches(".cardgrid > li") ? target.firstElementChild : target;
      }
      function fragmentTarget(hash) {
        try {
          return hash && document.getElementById(decodeURIComponent(hash.slice(1)));
        } catch {
          return null;
        }
      }
      function highlightTarget() {
        dismissMark();
        const target = fragmentTarget(location.hash);
        if (!target) return;
        const box = landingBox(target);
        marked = [box];
        box.classList.add("hub-arrived");
        if (motion.matches || typeof box.animate !== "function") return;
        const surface = tokens.getPropertyValue("--az-accent-surface").trim();
        const fadeIn = box.animate(
          [{ backgroundColor: "transparent" }, { backgroundColor: surface }],
          { duration: duration("--motion-feedback"), easing, fill: "forwards" });
        const fadeOut = box.animate(
          [{ backgroundColor: surface }, { backgroundColor: "transparent" }],
          { duration: duration("--motion-expand"), easing, delay: 1000, fill: "forwards" });
        arrival = [fadeIn, fadeOut];
        fadeOut.finished.then(() => {
          if (arrival.includes(fadeOut)) dismissMark();
        }, () => {});
      }
      window.addEventListener("hashchange", highlightTarget);
      for (const type of ["pointerdown", "keydown", "wheel", "touchstart"]) {
        window.addEventListener(type, dismissMark, { capture: true, passive: true });
      }
      motion.addEventListener("change", highlightTarget);
      highlightTarget();

      // In-page anchors glide only on an explicit click or Enter. Any scroll intent
      // hands the page back at once and skips the focus hand-off. Entry by address,
      // history traversal and reduced motion keep the native jump.
      let glide = null;
      function stopGlide() {
        if (!glide) return;
        const current = glide;
        glide = null;
        current.listener.abort();
        cancelAnimationFrame(current.frame);
      }
      function landing(target) {
        const pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
        const margin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
        const limit = document.documentElement.scrollHeight - innerHeight;
        const rest = Math.max(0, Math.min(limit, scrollY + target.getBoundingClientRect().top - pad - margin));
        // Engines round fractional scroll offsets differently; land on a device pixel.
        return Math.round(rest * devicePixelRatio) / devicePixelRatio;
      }
      function glideTo(to) {
        stopGlide();
        return new Promise((resolve) => {
          const from = scrollY;
          const span = to - from;
          const current = { listener: new AbortController(), expected: from, frame: 0, resolve };
          const settle = (arrived) => {
            stopGlide();
            if (arrived) scrollTo(0, to);
            resolve(arrived);
          };
          if (Math.abs(span) < 1) {
            settle(true);
            return;
          }
          glide = current;
          const options = { capture: true, passive: true, signal: current.listener.signal };
          for (const type of ["wheel", "touchstart", "pointerdown", "resize", "pagehide"]) {
            window.addEventListener(type, () => settle(false), options);
          }
          window.addEventListener("keydown", () => settle(false), options);
          window.addEventListener("visibilitychange", () => { if (document.hidden) settle(false); }, options);
          motion.addEventListener("change", () => settle(false), options);
          window.addEventListener("scroll", () => {
            if (glide && Math.abs(scrollY - glide.expected) > 1) settle(false);
          }, options);
          const started = performance.now();
          const time = Math.min(320, 180 + Math.abs(span) * .08);
          const tick = (now) => {
            const progress = Math.min(1, (now - started) / time);
            current.expected = from + span * (bezier ? bezier(progress) : progress);
            scrollTo(0, current.expected);
            if (progress < 1 && Math.abs(to - current.expected) >= 1) current.frame = requestAnimationFrame(tick);
            else settle(true);
          };
          current.frame = requestAnimationFrame(tick);
        });
      }
      document.addEventListener("click", async (event) => {
        if (motion.matches || event.defaultPrevented || event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const link = event.target.closest?.('a[href^="#"]:not(.skip-link)');
        if (!link) return;
        const hash = link.getAttribute("href");
        const target = fragmentTarget(hash);
        if (!target) return;
        if (location.hash !== hash) {
          try {
            history.pushState(history.state, "", hash);
          } catch (error) {
            if (error.name !== "SecurityError") throw error;
            return;
          }
        }
        event.preventDefault();
        window.dispatchEvent(new HashChangeEvent("hashchange"));
        if (!await glideTo(landing(target))) return;
        if (!target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
        target.focus({ preventScroll: true });
      });
    })();
  </script>
</body>
</html>
