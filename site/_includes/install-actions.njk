{% from "copy-control.njk" import copyControl %}
{% macro installActions(skillName, zh, installGuide, showCodex=true) %}
  {% set promptId = 'agent-install-' ~ skillName %}
  {% set target = installGuide ~ '#install-with-an-agent' %}
  <p>{{ '在当前项目打开 Agent 会话，粘贴这段安装提示词。' if zh else 'Open an agent session in your project and paste this install prompt.' }}</p>
  {{ copyControl(promptId, '复制安装提示词' if zh else 'Copy install prompt') }}
  <pre class="wrap-text"><code id="{{ promptId }}">{% if zh %}请按 {{ target }} 在当前项目只安装 {{ skillName }}，并确认当前 Agent 宿主能找到它。{% else %}Follow {{ target }} to install only {{ skillName }} in this project and check that this host discovers it.{% endif %}</code></pre>
  <details data-manual-install="{{ skillName }}">
    <summary>{{ '手动安装' if zh else 'Install manually' }}</summary>
    <p><a href="{{ installGuide }}#choose-your-agent-host" hreflang="en">{{ '按 Agent 宿主选择安装方式（英文）' if zh else 'Choose your agent host' }}</a></p>
    {% if showCodex %}
      {% set commandId = 'install-' ~ skillName %}
      <p>{{ 'Codex 示例：在项目目录用 Node.js 22.20 或更新版本运行，然后在同一项目打开新会话。' if zh else 'Codex example. Run from your project with Node.js 22.20 or later, then open a new chat in the same project.' }}</p>
      {{ copyControl(commandId, '复制安装命令' if zh else 'Copy install command') }}
      <pre class="wrap-text"><code id="{{ commandId }}">npx skills add TeFuirnever/azhou-ai-hub --skill {{ skillName }} --agent codex</code></pre>
    {% else %}
      <p><a href="{{ installGuide }}#checkout-assisted-setup" hreflang="en">{{ '使用本地仓库安装（英文）' if zh else 'Install from a local checkout' }}</a></p>
    {% endif %}
  </details>
{% endmacro %}
