---
layout: base.njk
---

{% set zh = lang == 'zh' %}
{% macro copyControl(source, label) %}
<div class="copy-actions" hidden>
  <button class="btn btn-outline" type="button" data-copy="{{ source }}">{{ label }}</button>
  <span class="copy-status" role="status"><span class="copy-check" aria-hidden="true">✓</span><span data-copy-message></span></span>
</div>
{% endmacro %}
<section class="home-hero">
  <div class="wrap home-hero-inner">
    <div>
    <h1>{{ '给 Agent 装上你需要的技能' if zh else 'Give your agent a skill for the job' }}</h1>
    <p class="lede">{{ '查 AI 官方原文，找适合当前任务的技能。' if zh else 'Find original AI publications and the agent skills to put what you learn to work.' }}</p>
    <div class="cta">
      <a class="btn btn-primary" href="{{ site.routes[lang].skills | url }}">{{ '浏览技能' if zh else 'Browse skills' }}</a>
      <a class="btn btn-outline" href="{{ site.routes[lang].library | url }}">{{ '打开来源库' if zh else 'Explore the Source Library' }}</a>
    </div>
    <a href="#install">{{ '在 Codex 安装 Ask Azhou' if zh else 'Install Ask Azhou in Codex' }}</a>
    </div>
    <img class="home-art" src="{{ '/assets/azhou-workspace.png' | url }}" width="1672" height="941"
      alt="{{ '阿舟在桌前的工作场景' if zh else 'Azhou at the workspace' }}" fetchpriority="high">
  </div>
</section>
{% if sourceLibrary.entries.length %}
<section class="sec home-edition">
  <div class="wrap">
    <div class="library-section-head">
      <h2>{{ '首发选文' if zh else 'The first edition' }}</h2>
      <a href="{{ '/library/rss.xml' | url }}">{{ '订阅 RSS' if zh else 'Subscribe by RSS' }}</a>
    </div>
    <div{% if sourceLibrary.featured %} class="home-edition-grid"{% endif %}>
      {% if sourceLibrary.featured %}
      {% set feature = sourceLibrary.featured %}
      <article class="edition-feature">
        <p class="entry-meta">{{ feature.sourceName | escape }} <a href="{{ feature.license_url | escape }}">{{ feature.license | escape }}</a></p>
        <h3 lang="{{ feature.lang | escape }}">{{ feature.title | escape }}</h3>
        <p>{{ (feature.note if zh else feature.noteEn) | escape }}</p>
        <a class="btn btn-primary" href="{{ (site.routes[lang].library ~ 'articles/' ~ feature.id ~ '/') | url }}">
          {{ '阅读归档' if zh else 'Read the archive' }}
        </a>
      </article>
      {% endif %}
      <ul class="edition-list">
        {% for item in sourceLibrary.entries %}
        {% if not sourceLibrary.featured or item.id != sourceLibrary.featured.id %}{% include "library-item.njk" %}{% endif %}
        {% endfor %}
      </ul>
    </div>
    <p><a href="{{ site.routes[lang].library | url }}">{{ '搜索全部来源' if zh else 'Search all sources' }}</a></p>
  </div>
</section>
{% endif %}
<section class="sec">
  <div class="wrap">
    <h2 id="capabilities">{{ '能力' if zh else 'Capabilities' }}</h2>
    <ul class="cardgrid">
      <li><a class="gcard" href="{{ site.routes[lang].skills | url }}">
        <span class="gcard-t">Hub Skills</span>
        <span class="gcard-d">{{ '按任务选用绘图、方案探索或仓库检查等技能。' if zh else 'Choose a skill for diagramming, exploring ideas or checking a repository.' }}</span>
      </a></li>
      <li><a class="gcard" href="{{ site.blobBase }}/packages/azhou-agent-inspector/README.md">
        <span class="gcard-t">{{ '阿舟 Agent 工作台' if zh else 'Azhou Agent Workbench' }}</span>
        <span class="gcard-d">{{ '在 Codex 和 ZCode 查看耗时、速率及性能详情。' if zh else 'See turn duration, speed and performance details in Codex and ZCode.' }}</span>
      </a></li>
      <li><a class="gcard" href="{{ site.blobBase }}/packages/pstack-agent-harness/README.md">
        <span class="gcard-t">pstack</span>
        <span class="gcard-d">{{ '用工程工作流推进实现、评审和 PR 跟进。' if zh else 'Use engineering workflows for implementation, review and pull request follow-up.' }}</span>
      </a></li>
      <li><a class="gcard" href="{{ site.routes[lang].books | url }}">
        <span class="gcard-t">Agent Rules Books</span>
        <span class="gcard-d">{{ '用书籍工程规则指导架构设计、重构和故障恢复。' if zh else 'Apply book-inspired rules to architecture, refactoring and failure recovery.' }}</span>
      </a></li>
    </ul>
  </div>
</section>
<section class="sec">
  <div class="wrap">
    <h2 id="install" tabindex="-1">{{ '安装 Ask Azhou' if zh else 'Install Ask Azhou' }}</h2>
    <p>{{ '登录 Codex。在终端进入项目目录，使用 Node.js 22.20 或更新版本运行下面的命令。出现安装提示时，确认安装到当前项目。' if zh else 'Sign in to Codex. In a terminal, open your project folder and run this command with Node.js 22.20 or later. When prompted, confirm the install for this project.' }}</p>
    {% set installGuide = site.blobBase ~ '/docs/installation.md' %}
    <p><a href="{{ installGuide }}#install-hub-components-in-codex" hreflang="en">{{ '一次安装或按需选择三个组件（英文）' if zh else 'Install Hub Skills, pstack and Agent Rules Books together or separately' }}</a></p>
    <div class="copy-block">
      {{ copyControl("install-command", '复制安装命令' if zh else 'Copy install command') }}
      <pre class="wrap-text"><code id="install-command">npx skills add TeFuirnever/azhou-ai-hub --skill super-ask-azhou --agent codex</code></pre>
    </div>
    <p>{{ '在同一项目打开新的 Codex 会话。先输入 $super-ask-azhou，确认 Codex 找得到这个技能，再试试下面的问题。正常情况下，它会推荐 super-archify。' if zh else 'Open a new Codex chat in the same project. Type $super-ask-azhou to check that Codex can find the skill, then try the question below. Expect a recommendation for super-archify.' }}</p>
    <div class="copy-block">
      {{ copyControl("try-prompt", '复制试用问题' if zh else 'Copy example question') }}
      <pre class="wrap-text"><code id="try-prompt">{{ '$super-ask-azhou 我有一段 Mermaid，想做成交互架构图。该用哪个技能？' if zh else '$super-ask-azhou I have a Mermaid diagram. Which skill turns it into an interactive architecture diagram?' }}</code></pre>
    </div>
    <details>
      <summary>{{ '安装上面推荐的技能' if zh else 'Install the recommended skill' }}</summary>
      <div class="copy-block">
        {{ copyControl("install-recommended", '复制 Archify 安装命令' if zh else 'Copy Archify install command') }}
        <pre class="wrap-text"><code id="install-recommended">npx skills add TeFuirnever/azhou-ai-hub --skill super-archify --agent codex</code></pre>
      </div>
    </details>
    <details>
      <summary>{{ '排查安装、更新或卸载' if zh else 'Troubleshoot, update, or uninstall' }}</summary>
      {%- if zh %}<p>以下指南为英文。</p>{% endif %}
      <ul>
        <li><a href="{{ installGuide }}#alternate-installer" hreflang="en">{{ '下载超时' if zh else 'Repository download timed out' }}</a></li>
        <li><a href="{{ installGuide }}#if-codex-cannot-find-ask-azhou" hreflang="en">{{ 'Codex 找不到技能' if zh else 'Codex cannot find the skill' }}</a></li>
        <li><a href="{{ installGuide }}#upgrade-or-uninstall" hreflang="en">{{ '更新或卸载技能' if zh else 'Update or uninstall a skill' }}</a></li>
      </ul>
    </details>
  </div>
</section>
<section class="sec">
  <div class="wrap">
    {% set cursor = '/assets/cursors/azhou-double-hug/' %}
    {% set cursorGuide = site.blobBase ~ cursor ~ 'README.md' %}
    <h2 id="cursor-theme">{{ '阿舟 macOS 鼠标指针' if zh else 'Azhou cursor theme for macOS' }}</h2>
    <p>{{ '在 Mousecape 导入「百变阿舟 · 抱一下」后，选中主题并点击 Apply 生效。' if zh else 'Import Azhou Double Hug in Mousecape, then select the theme and click Apply.' }}</p>
    <p><a href="{{ '/assets/Azhou-Double-Hug-3.6.1.cape' | url }}" download>{{ '下载鼠标指针主题' if zh else 'Download the cursor theme' }}</a>
    · <a href="{{ cursorGuide }}">{{ '查看预览和安装步骤' if zh else 'Preview and install' }}</a>
    · <a href="{{ cursorGuide }}#restore">{{ '恢复系统指针' if zh else 'Restore system cursors' }}</a></p>
  </div>
</section>
<script>
  for (const button of document.querySelectorAll("[data-copy]")) {
    if (!navigator.clipboard?.writeText) continue;
    const actions = button.parentElement;
    const status = actions.querySelector('[role="status"]');
    const message = status.querySelector("[data-copy-message]");
    actions.hidden = false;
    let attempt = 0;
    let reset;
    let pending;
    function showStatus(text, state) {
      status.dataset.state = state;
      if (message.textContent !== text) message.textContent = text;
    }
    button.addEventListener("click", async () => {
      const current = ++attempt;
      clearTimeout(reset);
      clearTimeout(pending);
      if (status.dataset.state !== "pending") {
        pending = setTimeout(() => {
          showStatus({{ ('正在复制…' if zh else 'Copying…') | dump | safe }}, "pending");
        }, 120);
      }
      const source = document.getElementById(button.dataset.copy);
      try {
        await navigator.clipboard.writeText(source.textContent);
        if (current !== attempt) return;
        showStatus({{ ('已复制' if zh else 'Copied') | dump | safe }}, "success");
        reset = setTimeout(() => showStatus("", ""), 3500);
      } catch {
        if (current !== attempt) return;
        showStatus({{ ('复制失败，请选中下方文字复制。' if zh else 'Copy failed. Select the text below.') | dump | safe }}, "error");
      } finally {
        if (current === attempt) clearTimeout(pending);
      }
    });
  }
</script>
