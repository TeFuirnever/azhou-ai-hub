---
layout: base.njk
---

{% set zh = lang == 'zh' %}
{% set installGuide = site.blobBase ~ '/docs/installation.md' %}
<article class="doc-card">
  <h1>{{ title }}</h1>
  <ul class="doclist" data-reveal>
    <li><a href="{{ site.routes[lang].home | url }}#install">{{ '安装 Ask Azhou' if zh else 'Install Ask Azhou' }}</a></li>
    <li><a href="{{ site.routes[lang].skills | url }}">{{ '找技能' if zh else 'Find skills' }}</a></li>
    <li><a href="{{ installGuide }}#check-that-your-host-finds-the-skill" hreflang="en"><span class="doc-link-text">{{ 'Agent 找不到已安装的技能' if zh else 'Your agent cannot find an installed skill' }}</span>{% if zh %}<span class="doc-link-note">（英文）</span>{% endif %}<span class="doc-ext-arrow" aria-hidden="true">↗</span></a></li>
    <li><a href="{{ installGuide }}#upgrade-or-uninstall" hreflang="en"><span class="doc-link-text">{{ '更新或卸载技能' if zh else 'Update or uninstall a skill' }}</span>{% if zh %}<span class="doc-link-note">（英文）</span>{% endif %}<span class="doc-ext-arrow" aria-hidden="true">↗</span></a></li>
    <li><a href="{{ site.routes[lang].support | url }}#compatibility">{{ '查看 Agent 工具的支持情况' if zh else 'Check agent host support' }}</a></li>
    <li><a href="{{ site.routes[lang].support | url }}#get-help">{{ '获取帮助或报告故障' if zh else 'Get help or report a bug' }}</a></li>
  </ul>
  <details>
    <summary>{{ '完整文档目录（英文）' if zh else 'Full documentation index' }}</summary>
    <ul class="doclist" lang="en">
      {%- for row in docsIndex %}
      <li>{{ row.need | escape }} —
        {%- for source in row.sources %}
        <a href="{{ source.url }}"{% if source.url.endsWith('.zh-CN.md') %} lang="zh-CN" hreflang="zh-CN"{% endif %}>{{ source.label | escape }}</a>{% if not loop.last %} and {% endif %}
        {%- endfor %}
      </li>
      {%- endfor %}
    </ul>
  </details>
</article>
