---
layout: base.njk
---

{% set zh = lang == 'zh' %}
<article class="doc-card">
  <h1>{{ title }}</h1>
  <ul class="doclist" data-reveal>
    <li><a href="{{ site.routes[lang].home | url }}#install">{{ '安装 Ask Azhou' if zh else 'Install Ask Azhou' }}</a></li>
    <li><a href="{{ site.blobBase }}/docs/installation.md#upgrade-or-uninstall" hreflang="en"><span class="doc-link-text">{{ '更新或卸载技能（英文）' if zh else 'Update or uninstall a skill' }}</span><span class="doc-ext-arrow" aria-hidden="true">↗</span></a></li>
    <li><a href="{{ site.routes[lang].support | url }}">{{ '查看 Agent 工具的支持情况' if zh else 'Check agent host support' }}</a></li>
    <li><a href="{{ site.blobBase }}/docs/foundations.md" hreflang="en"><span class="doc-link-text">{{ '诊断、安装或验证本地仓库（英文）' if zh else 'Diagnose, set up, or verify a checkout' }}</span><span class="doc-ext-arrow" aria-hidden="true">↗</span></a></li>
  </ul>
  <details>
    <summary>{{ '完整文档目录（英文）' if zh else 'Full documentation index' }}</summary>
    <ul class="doclist" lang="en">
      {%- for row in docsIndex %}
      <li>{{ row.need | escape }} —
        {%- for source in row.sources %}
        <a href="{{ source.url }}" hreflang="en">{{ source.label | escape }}</a>{% if not loop.last %} and {% endif %}
        {%- endfor %}
      </li>
      {%- endfor %}
    </ul>
  </details>
</article>
