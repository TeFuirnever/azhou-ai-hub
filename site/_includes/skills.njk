---
layout: base.njk
---

{% set zh = lang == 'zh' %}
{% from "copy-control.njk" import copyControl %}
{% set installGuide = site.blobBase ~ '/docs/installation.md' %}
<article class="doc-card">
  <h1>{{ title }}</h1>
  <p>{{ '选择一个技能，查看安装方式和使用说明。也可以让 Ask Azhou 为你推荐。' if zh else 'Select a skill for installation and usage instructions, or ask Ask Azhou for a recommendation.' }}
    <a href="{{ site.routes[lang].home | url }}#install">{{ '安装 Ask Azhou' if zh else 'Install Ask Azhou' }}</a>
  </p>
  <div id="skill-filter" role="search" hidden>
    <label for="skill-search">{{ '搜索任务或包名' if zh else 'Search tasks or package names' }}</label>
    <div class="skill-search-controls">
      <input id="skill-search" type="search" autocomplete="off" autocapitalize="none" spellcheck="false">
      <button id="clear-skill-search" class="btn btn-outline" type="button" disabled>{{ '清空搜索' if zh else 'Clear search' }}</button>
    </div>
    <p id="skill-count" role="status"
       data-all="{{ skills.length }} {{ '个技能' if zh else 'skills' }}"
       data-results="{{ '{total} 个技能中的 {count} 个' if zh else '{count} of {total} skills' }}"
       data-empty="{{ '没有匹配的技能。试试更短的关键词，或清空搜索。' if zh else 'No matching skills. Try fewer words or clear the search.' }}"></p>
  </div>
  <ul class="cardgrid" id="skill-list">
    {%- set other = 'en' if zh else 'zh' %}
    {%- for skill in skills %}
    <li id="{{ skill.name }}" data-other-language="{{ (skill.summary[other].title ~ ' ' ~ skill.summary[other].task) | escape }}">
      <details class="skill-catalog-row" name="hub-skill">
        <summary>
          <span class="gcard">
            <span class="gcard-t">{{ skill.summary[lang].title | escape }}</span>
            <span class="gcard-d">{{ skill.summary[lang].task | escape }}</span>
            <code class="skill-name">{{ skill.name }}</code>
          </span>
        </summary>
        <div class="skill-catalog-actions">
          {% if skill.name.startsWith('super-azhou-') %}
          <p>{{ '运行此技能需要本地 Hub 仓库。' if zh else 'This skill needs a local Hub checkout.' }}
            <a href="{{ installGuide }}#checkout-assisted-setup" hreflang="en">{{ '查看安装步骤（英文）' if zh else 'See setup steps' }}</a></p>
          {% elif skill.name == 'super-imagegen' %}
          <p>{{ '此技能需要本机已有私有技能 azhou-imagegen。' if zh else 'This skill requires the private azhou-imagegen skill on your machine.' }}</p>
          {% else %}
          {% set commandId = 'install-' ~ skill.name %}
          <p>{{ '在 Codex 项目目录运行，需要 Node.js 22.20 或更新版本。确认安装后，在同一项目打开新会话。' if zh else 'Run in your Codex project folder with Node.js 22.20 or later. Confirm installation, then open a new chat in the same project.' }}</p>
          {{ copyControl(commandId, '复制安装命令' if zh else 'Copy install command') }}
          <pre class="wrap-text"><code id="{{ commandId }}">npx skills add TeFuirnever/azhou-ai-hub --skill {{ skill.name | escape }} --agent codex</code></pre>
          {% endif %}
          <p><a href="{{ skill.url }}">{{ '查看技能说明' if zh else 'Read the skill guide' }}</a></p>
        </div>
      </details>
    </li>
    {%- endfor %}
  </ul>
</article>
<script>
  const input = document.getElementById("skill-search");
  const clear = document.getElementById("clear-skill-search");
  const catalogLanguageLink = document.getElementById("switch-language");
  const count = document.getElementById("skill-count");
  const items = Array.from(document.querySelectorAll("#skill-list > li"), element => ({
    element,
    keywords: (element.querySelector(".gcard").textContent + " " + element.dataset.otherLanguage).toLowerCase(),
  }));
  function setQuery(url, query) {
    if (query) url.searchParams.set("q", query);
    else url.searchParams.delete("q");
  }
  function updateSkills() {
    const query = input.value.trim();
    const terms = query.toLowerCase().split(/\s+/);
    let found = 0;
    for (const { element, keywords } of items) {
      const visible = terms.every(term => keywords.includes(term));
      if (element.hidden === visible) element.hidden = !visible;
      if (visible) found += 1;
    }
    const message = !query ? count.dataset.all :
      found ? count.dataset.results.replace("{total}", items.length).replace("{count}", found) : count.dataset.empty;
    if (count.textContent !== message) count.textContent = message;
    clear.disabled = input.value === "";

    const translated = new URL(catalogLanguageLink.href);
    setQuery(translated, query);
    if (catalogLanguageLink.href !== translated.href) catalogLanguageLink.href = translated.href;
  }
  function searchDraftKey() {
    const entry = history.state?.hubSkillSearchEntry;
    return entry ? "hub-skill-search:" + entry : null;
  }
  function restoreSearch() {
    if (!searchDraftKey()) {
      const entry = Array.from(crypto.getRandomValues(new Uint32Array(2))).join("-");
      try {
        history.replaceState({ ...history.state, hubSkillSearchEntry: entry }, "");
      } catch (error) {
        if (error.name !== "SecurityError") throw error;
      }
    }
    const key = searchDraftKey();
    let draft = null;
    if (key) {
      try {
        draft = sessionStorage.getItem(key);
      } catch {}
    }
    input.value = draft ?? new URLSearchParams(window.location.search).get("q") ?? "";
    if (draft === null) updateSkills();
    else saveSearch();
  }
  function saveSearch() {
    updateSkills();
    const current = new URL(window.location.href);
    const key = searchDraftKey();
    const query = input.value.trim();
    setQuery(current, query);
    try {
      if (current.href !== window.location.href) history.replaceState(history.state, "", current);
    } catch (error) {
      if (error.name !== "SecurityError") throw error;
      if (key) {
        try {
          sessionStorage.setItem(key, query);
        } catch {}
      }
      return;
    }
    if (key) {
      try {
        sessionStorage.removeItem(key);
      } catch {}
    }
  }
  input.addEventListener("input", (event) => {
    if (!event.isComposing) saveSearch();
  });
  input.addEventListener("compositionend", saveSearch);
  clear.addEventListener("click", () => {
    input.value = "";
    input.focus();
    saveSearch();
  });
  window.addEventListener("pageshow", event => {
    if (event.persisted) restoreSearch();
  });
  window.addEventListener("popstate", restoreSearch);
  restoreSearch();
  document.getElementById("skill-filter").hidden = false;
</script>
<script type="module" src="{{ '/assets/copy-control.js' | url }}"></script>
