---
layout: base.njk
route: library
pagination:
  data: sourceLibrary.articlePages
  size: 1
  alias: entry
  addAllPagesToCollections: true
permalink: "{{ entry.path }}index.html"
eleventyComputed:
  title: "{{ entry.title }}"
  lang: "{{ entry.locale }}"
  alternatePaths:
    en: "{{ entry.alternate.en }}"
    zh: "{{ entry.alternate.zh }}"
---
{% set zh = lang == 'zh' %}
<article class="wrap library-article"{% if not zh %} data-pagefind-body{% endif %}>
  <header class="article-heading">
    <a id="library-return" href="{{ site.routes[lang].library | url }}">{{ '返回来源库' if zh else 'Back to the Source Library' }}</a>
    <div class="entry-meta">
      {% for sourceId in entry.sources %}
        {% for source in sourceLibrary.channels %}
        {% if source.id == sourceId %}<a href="{{ (site.routes[lang].library ~ 'sources/' ~ source.id ~ '/') | url }}">{{ source.name | escape }}</a>{% endif %}
        {% endfor %}
      {% endfor %}
      {% if entry.published %}<time datetime="{{ entry.published | escape }}">{{ entry.published | truncate(10, true, '') | escape }}</time>{% endif %}
    </div>
    <h1 lang="{{ entry.lang | escape }}">{{ entry.title | escape }}</h1>
    {% if entry.author %}<p class="entry-meta">{{ entry.author | escape }}</p>{% endif %}
    <div class="library-actions" data-pagefind-ignore>
      <a class="btn btn-primary" href="{{ entry.url | escape }}">{{ '前往官方原文' if zh else 'Read at the original source' }}</a>
      {% if entry.license %}<a href="{{ entry.license_url | escape }}">{{ entry.license | escape }}</a>{% endif %}
    </div>
  </header>
  <div class="article-layout">
    {% if entry.scope == 'full' %}
    <details class="article-toc" data-pagefind-ignore>
      <summary>{{ '章节目录' if zh else 'Contents' }}</summary>
      <ol lang="en">
        {% for section in entry.sections %}<li><a href="#{{ section.id | escape }}">{{ section.title | escape }}</a></li>{% endfor %}
      </ol>
    </details>
    <script>
      const toc = document.querySelector(".article-toc");
      const wide = matchMedia("(min-width: 62rem)");
      const syncToc = () => {
        // A keyboard user inside the contents keeps their place when it folds away.
        if (toc.open && !wide.matches && toc.contains(document.activeElement)) toc.querySelector("summary").focus({ preventScroll: true });
        toc.open = wide.matches;
      };
      syncToc();
      wide.addEventListener("change", syncToc);
    </script>
    {% endif %}
    <div class="article-copy">
      <div class="reading-note">
        <h2>{{ '自写导读' if zh else 'Reading note' }}</h2>
        <p>{{ (entry.note if zh else entry.noteEn) | escape }}</p>
      </div>
      {% if entry.scope == 'full' %}
      <div class="reading-body" lang="{{ entry.lang | escape }}">{{ entry.readingBody | safe }}</div>
      {% endif %}
    </div>
  </div>
</article>
<script type="module" src="{{ '/assets/library-return.js' | url }}"></script>
