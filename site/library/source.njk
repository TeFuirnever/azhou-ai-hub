---
layout: base.njk
route: library
pagination:
  data: sourceLibrary.sourcePages
  size: 1
  alias: channel
  addAllPagesToCollections: true
permalink: "{{ channel.path }}index.html"
eleventyComputed:
  lang: "{{ channel.locale }}"
  title: "{{ channel.name }}"
  alternatePaths:
    en: "{{ channel.alternate.en }}"
    zh: "{{ channel.alternate.zh }}"
  sourceFeed: "/library/sources/{{ channel.id }}/rss.xml"
---
{% set zh = lang == 'zh' %}
{% from "rss-subscribe.njk" import rssSubscribe %}
<section class="library-intro">
  <div class="wrap">
    <a href="{{ site.routes[lang].library | url }}">{{ '来源库' if zh else 'Source Library' }}</a>
    <h1>{{ channel.name | escape }}</h1>
    <div class="library-actions">
      {{ rssSubscribe('rss-' ~ channel.id, site.siteUrl ~ sourceFeed, zh, channel.name) }}
      <a href="{{ channel.home | escape }}">{{ '访问官网' if zh else 'Visit the source website' }}</a>
    </div>
  </div>
</section>
<script type="module" src="{{ '/assets/copy-control.js' | url }}"></script>
<script type="module" src="{{ '/assets/library-return.js' | url }}"></script>
<section class="wrap library-source-content">
  <h2>{{ '选文' if zh else 'Selections' }}</h2>
  <ul class="edition-list">
    {% for item in channel.entries %}{% include "library-item.njk" %}{% endfor %}
  </ul>
  {% if not channel.entries.length %}<p>{{ '此来源的首批选文即将发布。现在可以先浏览其他官方来源，或订阅更新。' if zh else 'The first selections from this source are coming soon. Browse other official sources or subscribe for updates.' }}</p>{% endif %}
</section>
