Description: conservatively hold untracked and ignored worktrees in the Hub audit
Author: Azhou AI Hub
Forwarded: not-needed

The pinned upstream audit can label a merged worktree with untracked source
as safe and direct a forced removal. In the Hub distribution, preserve its
read-only table while marking untracked and ignored candidates as holds.
The separate playbook still requires specific owner approval before deletion.

--- a/pstack/skills/poteto-mode/scripts/worktree-audit.sh
+++ b/pstack/skills/poteto-mode/scripts/worktree-audit.sh
@@ -28,7 +28,11 @@
 git rev-parse --git-dir >/dev/null 2>&1 || { echo "error: not a git repo: $repo" >&2; exit 1; }
 
 # Main worktree is the first entry; everything else is a candidate.
-main_wt=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')
+main_wt=""
+while IFS= read -r -d '' record; do
+    case "$record" in worktree\ *) main_wt=${record#worktree }; break ;; esac
+done < <(git worktree list --porcelain -z)
+[ -n "$main_wt" ] || { echo "error: cannot determine main worktree" >&2; exit 1; }
 
 if [ -z "$base" ]; then
 	for cand in "$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)" origin/main origin/master; do
@@ -77,7 +81,8 @@
 echo "# base: $base"
 printf "SIZE\tAGE\tMERGED\tDIRTY\tREMOTE\tPR\tLAST_CHAT\tBUCKET\tWORKTREE\n"
 
-git worktree list --porcelain | awk '/^worktree /{print $2}' | while read -r wt; do
+while IFS= read -r -d '' record; do
+    case "$record" in worktree\ *) wt=${record#worktree } ;; *) continue ;; esac
 	[ "$wt" = "$main_wt" ] && continue
 
 	size=$(du -sh "$wt" 2>/dev/null | awk '{print $1}')
@@ -89,12 +94,29 @@
 	# real signal; merge-base only catches fast-forward/rebase merges.
 	git merge-base --is-ancestor "$head" "$base" 2>/dev/null && merged=YES || merged=no
 
-	# Distinguish real WIP (tracked edits) from disposable untracked scratch.
-	porcelain=$(git -C "$wt" status --porcelain 2>/dev/null)
-	if [ -z "$porcelain" ]; then dirty=clean
-	elif printf '%s\n' "$porcelain" | grep -qv '^??'; then
-		dirty="wip:$(printf '%s\n' "$porcelain" | grep -cv '^??')"
-	else dirty="scratch:$(printf '%s\n' "$porcelain" | grep -c '^??')"; fi
+	# Git status must succeed. Untracked-file hiding config and ignored paths
+	# must not turn unknown user files into an apparently clean worktree.
+	if ! porcelain=$(git -C "$wt" -c status.showUntrackedFiles=all status --porcelain=v1 --untracked-files=all --ignored=matching 2>/dev/null); then
+		dirty=unknown
+	elif [ -z "$porcelain" ]; then dirty=clean
+	elif printf '%s\n' "$porcelain" | grep -qEv '^(\?\?|!!)'; then
+		dirty="wip:$(printf '%s\n' "$porcelain" | grep -cEv '^(\?\?|!!)')"
+	elif printf '%s\n' "$porcelain" | grep -q '^??'; then
+		dirty="scratch:$(printf '%s\n' "$porcelain" | grep -c '^??')"
+	elif printf '%s\n' "$porcelain" | grep -q '^!!'; then
+		dirty="ignored:$(printf '%s\n' "$porcelain" | grep -c '^!!')"
+	else dirty=unknown; fi
+
+	# Operation state can be active with no tracked diff (empty pending merge,
+	# rebase, cherry-pick or revert). Unknown Git internals are not safe.
+	operation=clear
+	for operation_name in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD REBASE_HEAD rebase-merge rebase-apply sequencer; do
+		if ! operation_path=$(git -C "$wt" rev-parse --git-path "$operation_name" 2>/dev/null); then
+			operation=unknown; break
+		fi
+		case "$operation_path" in /*) ;; *) operation_path="$wt/$operation_path" ;; esac
+		if [ -e "$operation_path" ]; then operation=in-progress; break; fi
+	done
 
 	branch=$(git -C "$wt" symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")
 	if [ -z "$branch" ]; then remote=detached
@@ -119,16 +141,22 @@
 	fi
 	recent=$([ "$last_ts" -gt 0 ] 2>/dev/null && [ $(( (now - last_ts) / 86400 )) -le 4 ] && echo yes || echo no)
 
-	case "$dirty" in wip:*) bucket=hold-wip ;; *)
-		case "$pr" in */open|*/draft) bucket=hold-open-pr ;; *)
+	case "$dirty" in
+		wip:*) bucket=hold-wip ;;
+		scratch:*) bucket=hold-untracked ;;
+		ignored:*) bucket=hold-ignored ;;
+		unknown) bucket=review ;;
+		*)
+		if [ "$operation" != clear ]; then bucket=hold-operation
+		else case "$pr" in */open|*/draft) bucket=hold-open-pr ;; *)
 			if [ "$recent" = yes ]; then bucket=verify-recent-chat
-			elif [ "$merged" = YES ] || [ "$pr" != "-" ]; then bucket=safe
+			elif [ "$merged" = YES ]; then bucket=safe
 			else bucket=review; fi ;;
-		esac ;;
+			esac; fi ;;
 	esac
 
 	printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
 		"$size" "$age" "$merged" "$dirty" "$remote" "$pr" "$last" "$bucket" "$wt"
-done | sort -t$'\t' -k1,1 -rh
+done < <(git worktree list --porcelain -z) | sort -t$'\t' -k1,1 -rh
 
 rm -f "$prs"
